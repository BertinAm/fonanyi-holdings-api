# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.fonanyiholdingsltd.com
DJANGO_LOG_LEVEL=INFO

# ---- Database ----
# Local development: DB_ENGINE=sqlite
# Namecheap:         DB_ENGINE=mysql  (cPanel prefixes names, e.g. cpuser_fonanyi)
DB_ENGINE=mysql
DB_NAME=cpuser_fonanyi
DB_USER=cpuser_fonanyi
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ---- URLs ----
SITE_URL=https://api.fonanyiholdingsltd.com
FRONTEND_URL=https://fonanyiholdingsltd.com
CORS_ALLOWED_ORIGINS=https://fonanyiholdingsltd.com,https://www.fonanyiholdingsltd.com
CSRF_TRUSTED_ORIGINS=https://fonanyiholdingsltd.com,https://www.fonanyiholdingsltd.com

# ---- Media / static (cPanel serves these directly from public_html) ----
DJANGO_MEDIA_ROOT=/home/cpuser/public_html/media
DJANGO_MEDIA_URL=/media/
DJANGO_STATIC_URL=/static/

# ---- Mail (cPanel SMTP) ----
EMAIL_HOST=mail.fonanyiholdingsltd.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=noreply@fonanyiholdingsltd.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@fonanyiholdingsltd.com
CONTACT_NOTIFY_EMAIL=info@fonanyiholdingsltd.com

# ---- Cloudflare Pages rebuild hook (fires when content is published) ----
CLOUDFLARE_DEPLOY_HOOK=

# ---- Housekeeping ----
ANALYTICS_RETENTION_DAYS=180

# ---- HTTPS hardening ----
# Leave SECURE_HSTS_SECONDS at 0 until HTTPS is confirmed on every subdomain.
# Then set it to 3600, watch for a week, and raise it to 31536000.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
