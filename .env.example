# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.fonanyiholdingsltd.com
DJANGO_LOG_LEVEL=INFO

# ---- Database ----
# Local development: DB_ENGINE=sqlite
# Namecheap:         DB_ENGINE=mysql  (cPanel prefixes names, e.g. cpuser_fonanyi)
DB_ENGINE=mysql
DB_NAME=cpuser_fonanyi
DB_USER=cpuser_fonanyi
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ---- URLs ----
SITE_URL=https://api.fonanyiholdingsltd.com
FRONTEND_URL=https://fonanyiholdingsltd.com
CORS_ALLOWED_ORIGINS=https://fonanyiholdingsltd.com,https://www.fonanyiholdingsltd.com
CSRF_TRUSTED_ORIGINS=https://fonanyiholdingsltd.com,https://www.fonanyiholdingsltd.com

# ---- Media / static (cPanel serves these directly from public_html) ----
# Outside the document root on purpose: the application directory IS the
# document root on cPanel, so uploads go in a sibling, never a child.
DJANGO_MEDIA_ROOT=/home/cpuser/fonanyi-media
DJANGO_MEDIA_URL=/media/
DJANGO_STATIC_URL=/static/

# ---- Mail (cPanel SMTP) ----
# The mail server runs on this same account, so localhost is the short path:
# no DNS, and no TLS certificate that has to match a name.
#
# Two things the cPanel "Mail Client Manual Settings" panel will not tell you:
#
#   * Do not use the bare domain as the outgoing server. It points at
#     Cloudflare, which does not carry SMTP, so the connection hangs.
#   * mail.<domain> on 465 does resolve to the host, but it presents the
#     shared *.web-hosting.com certificate. Django verifies hostnames by
#     default, so that combination fails with a CERTIFICATE_VERIFY_FAILED
#     hostname mismatch unless AutoSSL has issued a certificate covering
#     mail.<domain>.
#
# Confirm before trusting any of it:  python manage.py check_email --probe
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_SSL=False
EMAIL_USE_TLS=False
EMAIL_HOST_USER=noreply@fonanyiholdingsltd.com
# This relay does accept AUTH on localhost, so the mailbox password belongs
# here and mail is sent as that mailbox rather than as the system user.
# If a future host's relay does not offer AUTH, Django raises
# SMTPNotSupportedError and the password has to be blanked instead;
# check_email says so explicitly when that happens.
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@fonanyiholdingsltd.com
# Where enquiries and job applications are sent. Without this, the forms still
# save but nobody is told.
CONTACT_NOTIFY_EMAIL=info@fonanyiholdingsltd.com

# ---- Cloudflare Pages rebuild hook (fires when content is published) ----
CLOUDFLARE_DEPLOY_HOOK=

# ---- Housekeeping ----
ANALYTICS_RETENTION_DAYS=180

# ---- HTTPS hardening ----
# Leave SECURE_HSTS_SECONDS at 0 until HTTPS is confirmed on every subdomain.
# Then set it to 3600, watch for a week, and raise it to 31536000.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
